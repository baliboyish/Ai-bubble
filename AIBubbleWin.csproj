<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/ai-bubble.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <RootNamespace>MuseBubbleWin</RootNamespace>
    <AssemblyName>AIBubbleWin</AssemblyName>
    <Version>1.1.0</Version>
    <Description>Floating Windows bubble for ChatGPT, Claude and Muse with website login.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/baliboyish/Ai-bubble</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="MuseBubbleWin.cs" />
    <Compile Include="Bubble.cs" />
    <Compile Include="Providers.cs" />
    <Compile Include="AppleTheme.cs" />
    <Compile Include="FilePickerBridge.cs" />
    <Compile Include="MuseOfficialIcon.cs" />
    <EmbeddedResource Include="MuseTheme.js" LogicalName="MuseTheme.js" />
    <EmbeddedResource Include="MuseTheme.css" LogicalName="MuseTheme.css" />
    <Reference Include="System.Web.Extensions" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
